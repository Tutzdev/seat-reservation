# Copy to .env before running docker compose. Payments go through wallet-ledger
# (https://github.com/Tutzdev/wallet-ledger), which must be running and reachable.
LEDGER_URL=http://host.docker.internal:8081
# The ledger operator this service logs in as.
LEDGER_EMAIL=admin@ledger.dev
LEDGER_PASSWORD=change-me-please
# The ledger account (BRL) that receives ticket sales. Create it with POST /api/v1/accounts on the ledger.
LEDGER_MERCHANT_ACCOUNT_ID=
# Signs the access tokens customers log in with. At least 32 characters; generate one with: openssl rand -base64 48
JWT_SECRET=
# The first organizer, who can create events. Created on startup if the e-mail is not registered yet.
ORGANIZER_EMAIL=organizer@tickets.dev
ORGANIZER_PASSWORD=change-me-please
